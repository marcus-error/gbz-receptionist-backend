PORT=
APP_ENV=production
APP_PORT=8000
API_PREFIX=/api/v1

DATABASE_URL=
CHROMA_DB_PATH=
DB_AUTO_CREATE=true

CORS_ORIGINS=

API_SECRET_KEY=
JWT_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

# Local Open-Source AI Engines
STT_PROVIDER=faster-whisper
STT_MODEL_SIZE=small
WHISPER_MODEL=small

NLP_MODEL=local

# Mistral LLM Primary / Answer Generator
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-tiny
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# xAI Grok Secondary LLM
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# Optional Gemini (Query rewriting / Intent Normalization only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# RAG & Sentence Transformer Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5
SIMILARITY_THRESHOLD=0.35
HOSPITAL_ID=mgm_healthcare_chennai

TTS_PROVIDER=murf
MURF_API_KEY=
MURF_VOICE_ID=Anusha
MURF_MODEL=Falcon
TTS_MODEL=default

# Emotion Detection API (Only external AI API allowed)
EMOTION_API_KEY=
EMOTION_API_URL=
EMOTION_API_TIMEOUT=1.5

# Telephony (Twilio / SIP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_URL=

# WhatsApp Integration (Meta WhatsApp Cloud API)
WHATSAPP_PHONE_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=callzenza_webhook_verify_token_123
WHATSAPP_GRAPH_VERSION=v23.0

# Email / Mail Integration (Resend / SendGrid / SMTP)
EMAIL_PROVIDER=Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# SendGrid API (Optional)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# SMTP Configuration (Optional Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SENDER_NAME=Callzenza AI Receptionist


